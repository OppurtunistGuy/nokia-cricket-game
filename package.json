{
  "name": "cricket-cup",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "bash scripts/android-build.sh",
    "format": "prettier --write src tests scripts/*.mjs *.ts index.html"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
